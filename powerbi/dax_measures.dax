// ===============================================================================
// FlightPulse Power BI DAX Measures Library
// Production-grade DAX formulas for Flight Delay Intelligence Platform
// ===============================================================================

// -------------------------------------------------------------------------------
// 1. VOLUME & OPERATIONAL FLIGHT COUNTS
// -------------------------------------------------------------------------------

// Total volume of scheduled flights in the current filter context
[Total Flights] = 
COUNTROWS(FactFlights)

// Total flights that actually operated (excluding cancellations)
[Operated Flights] = 
CALCULATE(
    COUNTROWS(FactFlights),
    FactFlights[status] <> "CANCELLED"
)

// Total cancelled flight operations
[Cancelled Flights] = 
CALCULATE(
    COUNTROWS(FactFlights),
    FactFlights[status] = "CANCELLED"
)

// Flights that operated on time (delay <= 15 minutes, standard FAA definition)
[On-Time Flights] = 
CALCULATE(
    COUNTROWS(FactFlights),
    FactFlights[departure_delay_minutes] <= 15,
    FactFlights[status] <> "CANCELLED"
)

// Proportion of scheduled flights that were cancelled
[Cancellation Rate] = 
DIVIDE(
    [Cancelled Flights],
    [Total Flights],
    0
)


// -------------------------------------------------------------------------------
// 2. DELAY THRESHOLDS & RATES (HANDLING CANCELLED FLIGHTS CORRECTLY)
// -------------------------------------------------------------------------------

// Total operated flights that experienced departure delays strictly > 15 minutes
[Delayed Flights] = 
CALCULATE(
    COUNTROWS(FactFlights),
    FactFlights[departure_delay_minutes] > 15,
    FactFlights[status] <> "CANCELLED"
)

// Proportion of operated flights delayed > 15 minutes
[Delay Rate %] = 
DIVIDE(
    [Delayed Flights],
    [Operated Flights],
    0
)

// Proportion of operated flights departing on schedule or within 15 minutes
[On-Time Rate %] = 
DIVIDE(
    [On-Time Flights],
    [Operated Flights],
    0
)

// Flights delayed greater than 15 minutes (FAA threshold)
[Flights Delayed >15 Minutes] = 
CALCULATE(
    COUNTROWS(FactFlights),
    FactFlights[departure_delay_minutes] > 15,
    FactFlights[status] <> "CANCELLED"
)

// Flights delayed greater than 60 minutes (Severe delay threshold)
[Flights Delayed >60 Minutes] = 
CALCULATE(
    COUNTROWS(FactFlights),
    FactFlights[departure_delay_minutes] > 60,
    FactFlights[status] <> "CANCELLED"
)


// -------------------------------------------------------------------------------
// 3. DELAY DURATION AVERAGES & EXTREMES
// -------------------------------------------------------------------------------

// Average departure delay in minutes across all operated flights (including on-time)
[Average Departure Delay] = 
CALCULATE(
    AVERAGE(FactFlights[departure_delay_minutes]),
    FactFlights[status] <> "CANCELLED"
)

// Average arrival delay in minutes across all operated flights
[Average Arrival Delay] = 
CALCULATE(
    AVERAGE(FactFlights[arrival_delay_minutes]),
    FactFlights[status] <> "CANCELLED"
)

// Average departure delay strictly computed over flights that were actually delayed (>15m)
[Average Delay for Delayed Flights] = 
CALCULATE(
    AVERAGE(FactFlights[departure_delay_minutes]),
    FactFlights[departure_delay_minutes] > 15,
    FactFlights[status] <> "CANCELLED"
)

// Maximum departure delay recorded in minutes
[Maximum Departure Delay] = 
CALCULATE(
    MAX(FactFlights[departure_delay_minutes]),
    FactFlights[status] <> "CANCELLED"
)


// -------------------------------------------------------------------------------
// 4. DETERMINISTIC DELAY INTELLIGENCE MEASURES
// -------------------------------------------------------------------------------

// Flights with high confidence causal attribution from the intelligence engine
[High Confidence Attributions] = 
CALCULATE(
    COUNTROWS(FactFlights),
    FactFlights[confidence_level] = "HIGH"
)

// Proportion of delayed flights with high confidence attribution
[High Confidence Attribution %] = 
DIVIDE(
    [High Confidence Attributions],
    [Delayed Flights],
    0
)

// Average score of the primary candidate cause (scaled 0-100%)
[Average Confidence Score %] = 
AVERAGEX(
    FILTER(FactFlights, NOT(ISBLANK(FactFlights[confidence_score]))),
    FactFlights[confidence_score] * 100
)

// Flights where carrier-reported category differs from engine's inferred cause
[Reported vs Inferred Mismatch Count] = 
CALCULATE(
    COUNTROWS(FactFlights),
    FactFlights[departure_delay_minutes] > 15,
    NOT(ISBLANK(FactFlights[reported_delay_category])),
    FactFlights[reported_delay_category] <> FactFlights[primary_candidate_cause]
)


// -------------------------------------------------------------------------------
// 5. WEATHER & DISRUPTION CORRELATION MEASURES
// -------------------------------------------------------------------------------

// Flights operating during observed thunderstorm conditions near departure
[Flights Observed During Thunderstorms] = 
CALCULATE(
    [Total Flights],
    FILTER(
        FactFlights,
        FactFlights[flight_id] IN (
            SELECTCOLUMNS(
                FILTER(FactWeather, FactWeather[is_thunderstorm] = 1),
                "FlightId", FactWeather[airport_id] // Correlated via origin airport and temporal window
            )
        )
    )
)

// Total active FAA Ground Stops affecting current filter context
[Total Ground Stops] = 
CALCULATE(
    COUNTROWS(FactDisruptions),
    FactDisruptions[event_type] = "GROUND_STOP"
)

// Total active FAA Ground Delay Programs / NAS Advisories
[Total Ground Delay Programs] = 
CALCULATE(
    COUNTROWS(FactDisruptions),
    FactDisruptions[event_type] = "GROUND_DELAY"
)


// -------------------------------------------------------------------------------
// 6. ROLE-PLAYING AIRPORT RELATIONSHIPS (USERELATIONSHIP)
// -------------------------------------------------------------------------------

// Departure delay calculated strictly through Origin Airport relationship (Active)
[Origin Average Departure Delay] = 
CALCULATE(
    [Average Departure Delay],
    USERELATIONSHIP(FactFlights[origin_airport_id], DimAirport[airport_id])
)

// Arrival delay calculated strictly through Destination Airport relationship (Inactive)
[Destination Average Arrival Delay] = 
CALCULATE(
    [Average Arrival Delay],
    USERELATIONSHIP(FactFlights[destination_airport_id], DimAirport[airport_id])
)
