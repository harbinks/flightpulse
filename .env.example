# PostgreSQL Database Connection (Provide either DATABASE_URL or individual host/port/name/user/pass)
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flightpulse
DB_USER=postgres
DB_PASSWORD=your_password_here

# Server & Network Configuration
PORT=8000
CORS_ORIGINS=http://localhost:5173,https://your-flightpulse-app.vercel.app

# OpenSky Network API (Optional for free anonymous access; recommended for higher rate limits)
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
OPENSKY_BASE_URL=https://opensky-network.org/api

# Pipeline Mode: 'opensky' or 'fixture'
FLIGHT_DATA_SOURCE=fixture

# Local Ollama AI Analyst
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest
OLLAMA_TIMEOUT_SEC=120

# Logging
LOG_LEVEL=INFO

